<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>JsonOverride</AssemblyName>
    <Description>Generic JSON Mod Loader for Hero's Adventure Mobile IL2CPP</Description>
    <Version>2.5.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- อ้างอิงไฟล์แกนหลักจากโฟลเดอร์ core ที่อยู่ตามภาพของคุณ -->
    <Reference Include="BepInEx.Core">
      <HintPath>..\BepInEx\core\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>..\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    
    <!-- อ้างอิงไฟล์คลาสข้อมูลของตัวเกม (สำหรับ IL2CPP มักจะอยู่ในโฟลเดอร์ BepInEx/interop หรือ Managed) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>..\GameData\Managed\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>..\GameData\Managed\Il2Cppmscorlib.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
